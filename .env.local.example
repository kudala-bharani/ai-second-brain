# ============================================
# AI Second Brain — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Stack:
#   LLM        → OpenRouter  (free models: Llama 3.1, Mistral, Gemma, etc.)
#   Embeddings → HuggingFace (free, no key required for basic usage)
#   Database   → Supabase    (free tier)
# ============================================


# --------------------------------------------
# Supabase
# --------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# --------------------------------------------
# OpenRouter  (replaces OpenAI)
# --------------------------------------------
# Free API key at: https://openrouter.ai/keys
# Free models list: https://openrouter.ai/models?q=free
#
# The app uses: meta-llama/llama-3.1-8b-instruct:free
# You can change the model in: src/app/api/query/route.ts → LLM_MODEL
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key


# --------------------------------------------
# HuggingFace  (free embeddings)
# --------------------------------------------
# The app uses BAAI/bge-small-en-v1.5 (384-dim vectors).
# You can run without a token on the shared free tier, but adding one
# gives better reliability and rate limits.
#
# Free token at: https://huggingface.co/settings/tokens
# Leave blank to use keyless mode.
HUGGINGFACE_API_KEY=hf_your_token_here


# --------------------------------------------
# App URL  (optional)
# --------------------------------------------
# Used as the HTTP-Referer header sent to OpenRouter (helps with their
# dashboard analytics). Defaults to http://localhost:3000 if not set.
# Set this to your production URL when deploying to Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
